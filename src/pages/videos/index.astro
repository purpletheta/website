---
import BaseLayout from '../../layouts/BaseLayout.astro';
const videos=[{title:'Squares and Square Roots',category:'Class 8 Mathematics',desc:'A growing collection of video lessons covering square numbers, patterns and square roots.'},{title:'Cubes and Cube Roots',category:'Class 8 Mathematics',desc:'Lessons on cubes, perfect cubes, patterns and cube roots.'},{title:'Exponents and Powers',category:'Class 8 Mathematics',desc:'Understand exponent laws and use powers to represent numbers.'}];
---
<BaseLayout title="Videos" description="Watch PurpleTheta mathematics videos and organized YouTube lessons for Class 8, 9 and 10."><section class="page-hero"><div class="wrap page-heading"><p class="eyebrow">Watch · Learn</p><h1>Video Library</h1><p>Video lessons and visual explanations to make mathematical ideas easier to understand. New videos will be added here as they are published.</p></div></section><section class="section"><div class="wrap"><div class="video-grid">{videos.map(video=><article class="video-card"><div class="video-thumb"><span>▶</span></div><div class="video-info"><div class="article-meta">{video.category}</div><h3>{video.title}</h3><p>{video.desc}</p><span class="card-link">Video links coming soon</span></div></article>)}</div><p class="empty-note" style="margin-top:24px">To add a video, copy a card in this page and replace the title, description and YouTube link. You can optionally add a thumbnail image.</p></div></section></BaseLayout>
