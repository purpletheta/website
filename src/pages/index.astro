---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const blogs = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf()).slice(0,3);
---
<BaseLayout title="Mathematics, made meaningful" description="Learn mathematics, explore ideas and discover useful knowledge. Class 8–10 mathematics, articles, videos and books from PurpleTheta.">
  <section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Mathematics · Knowledge · Learning</p><h1>Mathematics,<br /><em>made meaningful.</em></h1><p class="hero-copy">Understand concepts. Explore ideas. Learn at your own pace. A place for clear mathematics and curious minds.</p><div class="actions"><a class="button" href="/math/">Explore Mathematics <span>↗</span></a><a class="text-link" href="/blog/">Discover articles →</a></div></div><div class="hero-art" aria-label="Abstract theta mathematics artwork"><span class="art-label one">LEARN · EXPLORE</span><span class="theta-large">θ</span><span class="art-label two">THINK A LITTLE DEEPER</span></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><h2>Explore Mathematics</h2><p>Build understanding, one concept at a time.</p></div><a class="text-link" href="/math/">View all classes ↗</a></div><div class="class-grid"><article class="class-card"><span class="class-number">CLASS 08</span><h3>Mathematics</h3><p>Explore concepts, examples and practice designed to build a strong foundation.</p><a class="card-link" href="/math/class-8/">Explore Class 8 →</a></article><article class="class-card"><span class="class-number">CLASS 09</span><h3>Mathematics</h3><p>A structured place for lessons, chapter notes and practice material.</p><a class="card-link" href="/math/class-9/">Explore Class 9 →</a></article><article class="class-card"><span class="class-number">CLASS 10</span><h3>Mathematics</h3><p>Learn, revise and strengthen key mathematical ideas and skills.</p><a class="card-link" href="/math/class-10/">Explore Class 10 →</a></article></div></div></section>
  <section class="section"><div class="wrap"><div class="section-head"><div><h2>More to explore</h2><p>Learning doesn't stop at the classroom.</p></div></div><div class="feature-grid"><a class="feature-card" href="/blog/"><span class="mini-label">READ</span><h3>Ideas &amp; Articles</h3><p>Mathematics, science, interesting facts and topics worth thinking about.</p><span class="card-link">Explore the blog →</span></a><a class="feature-card" href="/videos/"><span class="mini-label">WATCH</span><h3>Video Library</h3><p>Visual lessons and topic-based videos to make ideas easier to understand.</p><span class="card-link">Browse videos →</span></a><a class="feature-card" href="/books/"><span class="mini-label">READ DEEPER</span><h3>Books</h3><p>Explore e-books and learning resources from PurpleTheta.</p><span class="card-link">Discover books →</span></a></div></div></section>
  {blogs.length>0 && <section class="section"><div class="wrap"><div class="section-head"><div><h2>From the blog</h2><p>Fresh ideas and explanations to explore.</p></div><a class="text-link" href="/blog/">All articles ↗</a></div><div class="blog-grid">{blogs.map(blog=><article class="article-card"><div class="article-body"><div class="article-meta">{blog.data.category} · {blog.data.pubDate.toLocaleDateString('en',{dateStyle:'medium'})}</div><h3>{blog.data.title}</h3><p>{blog.data.description}</p><a class="card-link" href={`/blog/${blog.slug}/`}>Read article →</a></div></article>)}</div></div></section>}
  <section class="cta-band"><div class="wrap cta-band-inner"><div><h2>Curiosity is a good place to start.</h2><p>Find a concept, question or idea—and explore it.</p></div><a class="button" href="/math/">Start exploring <span>↗</span></a></div></section>
</BaseLayout>
