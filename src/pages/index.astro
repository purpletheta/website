---
/* ==========================================================================
   HOMEPAGE DATA FETCHING
   Automatically pulls your latest 3 blog posts and featured books from
   src/content/blog and src/content/books so you never have to update manually.
   ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogs = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const books = (await getCollection('books', ({ data }) => !data.draft)).slice(0, 3);
---

<BaseLayout
  title="Mathematics, made meaningful"
  description="Learn mathematics, explore ideas and discover useful knowledge. Class 8–10 mathematics, articles, videos and books from PurpleTheta."
>
  <!-- ======================================================================
       1. HERO SECTION (Main introduction banner)
       ====================================================================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Mathematics · Knowledge · Learning</p>
        <h1>
          Mathematics,<br />
          <em>made meaningful.</em>
        </h1>
        <p class="hero-copy">
          Understand concepts. Explore ideas. Learn at your own pace. A calm, structured space for clear mathematics and curious minds.
        </p>
        <div class="actions">
          <a class="button" href="/math/">Explore Mathematics <span>↗</span></a>
          <a class="text-link" href="/blog/">Discover articles →</a>
        </div>
      </div>

      <!-- Right-side Geometric Theta Artwork -->
      <div class="hero-art" aria-label="Abstract theta mathematics artwork">
        <span class="art-label one">LEARN · EXPLORE</span>
        <span class="theta-large">θ</span>
        <span class="art-label two">THINK A LITTLE DEEPER</span>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       2. MATHEMATICS CLASSES SECTION (Class 8, 9, and 10 cards)
       ====================================================================== -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Explore Mathematics</h2>
          <p>Build understanding, one concept at a time.</p>
        </div>
        <a class="text-link" href="/math/">View all classes ↗</a>
      </div>

      <div class="class-grid">
        <article class="class-card">
          <span class="class-number">CLASS 08</span>
          <h3>Foundation Mathematics</h3>
          <p>Explore core concepts, clear examples, and structured practice designed to build confidence.</p>
          <a class="card-link" href="/math/class-8/">Explore Class 8 →</a>
        </article>

        <article class="class-card">
          <span class="class-number">CLASS 09</span>
          <h3>Intermediate Mathematics</h3>
          <p>A structured place for step-by-step lessons, chapter notes, and guided practice material.</p>
          <a class="card-link" href="/math/class-9/">Explore Class 9 →</a>
        </article>

        <article class="class-card">
          <span class="class-number">CLASS 10</span>
          <h3>Board & Mastery Math</h3>
          <p>Learn, revise, and strengthen key mathematical ideas and problem-solving skills.</p>
          <a class="card-link" href="/math/class-10/">Explore Class 10 →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       3. MORE TO EXPLORE SECTION (Blogs, Videos, Books overview)
       ====================================================================== -->
  <section class="section section-soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>More to explore</h2>
          <p>Learning doesn't stop at the classroom.</p>
        </div>
      </div>

      <div class="feature-grid">
        <a class="feature-card" href="/blog/">
          <span class="mini-label">READ</span>
          <h3>Ideas & Articles</h3>
          <p>Mathematics, science, fascinating facts, and topics worth thinking about.</p>
          <span class="card-link">Explore the blog →</span>
        </a>

        <a class="feature-card" href="/videos/">
          <span class="mini-label">WATCH</span>
          <h3>Video Library</h3>
          <p>Visual lessons and topic-based videos to make complex ideas intuitive.</p>
          <span class="card-link">Browse videos →</span>
        </a>

        <a class="feature-card" href="/books/">
          <span class="mini-label">READ DEEPER</span>
          <h3>Books & Guides</h3>
          <p>Explore illustrated e-books and learning resources from PurpleTheta.</p>
          <span class="card-link">Discover books →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       4. FEATURED BOOKS SECTION (Automatically shown if you have books)
       ====================================================================== -->
  {books.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Featured Books</h2>
            <p>Curated reads and visual explorations for curious learners.</p>
          </div>
          <a class="text-link" href="/books/">All books ↗</a>
        </div>

        <div class="book-grid">
          {books.map((book) => (
            <article class="book-card">
              <div class="book-cover">
                {book.data.cover ? (
                  <img src={book.data.cover} alt={book.data.title} loading="lazy" />
                ) : (
                  <span>{book.data.title}</span>
                )}
              </div>
              <div class="book-info">
                <h3>{book.data.title}</h3>
                <p>{book.data.description}</p>
                <a class="card-link" href={`/books/${book.slug}/`}>View book →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================================
       5. LATEST BLOG ARTICLES SECTION (Automatically pulls newest 3 posts)
       ====================================================================== -->
  {blogs.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>From the blog</h2>
            <p>Fresh ideas and clear explanations to explore.</p>
          </div>
          <a class="text-link" href="/blog/">All articles ↗</a>
        </div>

        <div class="blog-grid">
          {blogs.map((blog) => (
            <article class="article-card">
              <div class="article-body">
                <div class="article-meta">
                  {blog.data.category} · {blog.data.pubDate.toLocaleDateString('en', { dateStyle: 'medium' })}
                </div>
                <h3>{blog.data.title}</h3>
                <p>{blog.data.description}</p>
                <a class="card-link" href={`/blog/${blog.slug}/`}>Read article →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================================
       6. BOTTOM CALL-TO-ACTION BANNER
       ====================================================================== -->
  <section class="cta-band">
    <div class="wrap cta-band-inner">
      <div>
        <h2>Curiosity is a good place to start.</h2>
        <p>Find a concept, question, or idea—and explore it at your own pace.</p>
      </div>
      <a class="button" href="/math/">Start exploring <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
