---
/* ==========================================================================
   HOMEPAGE DATA FETCHING
   Pulls your latest 3 videos/playlists, latest 3 blog posts, and featured books.
   ========================================================================== */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recentVideos = (await getCollection('videos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const blogs = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const books = (await getCollection('books', ({ data }) => !data.draft)).slice(0, 3);

function getVideoThumbnail(rawUrl: string) {
  try {
    const url = new URL(rawUrl);
    let videoId = '';
    if (url.hostname.includes('youtu.be')) {
      videoId = url.pathname.replace('/', '').trim();
    } else if (url.pathname.includes('/embed/')) {
      videoId = url.pathname.split('/embed/')[1]?.split('/')[0] || '';
    } else {
      videoId = url.searchParams.get('v') || '';
    }
    return videoId ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg` : '';
  } catch {
    return '';
  }
}
---

<BaseLayout
  title="Mathematics, made meaningful"
  description="Learn mathematics, explore ideas and discover useful knowledge. Class 8–10 mathematics, videos, articles and books from PurpleTheta."
>
  <!-- ======================================================================
       1. HERO SECTION
       ====================================================================== -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Mathematics · Knowledge · Learning</p>
        <h1>
          Mathematics,<br />
          <em>made meaningful.</em>
        </h1>
        <p class="hero-copy">
          Understand concepts. Explore ideas. Learn at your own pace. A calm, structured space for clear mathematics and curious minds.
        </p>
        <div class="actions">
          <a class="button" href="/math/">Explore Mathematics <span>↗</span></a>
          <a class="text-link" href="/videos/">Watch playlists →</a>
        </div>
      </div>

      <!-- Right-side Geometric Theta Artwork -->
      <div class="hero-art" aria-label="Abstract theta mathematics artwork">
        <span class="art-label one">LEARN · EXPLORE</span>
        <span class="theta-large">θ</span>
        <span class="art-label two">THINK A LITTLE DEEPER</span>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       2. MATH SECTION (Class 8, 9, and 10 cards)
       ====================================================================== -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>Explore Mathematics</h2>
          <p>Build understanding, one concept at a time.</p>
        </div>
        <a class="text-link" href="/math/">View all classes ↗</a>
      </div>

      <div class="class-grid">
        <article class="class-card">
          <span class="class-number">CLASS 08</span>
          <h3>Foundation Mathematics</h3>
          <p>Explore core concepts, clear examples, and structured practice designed to build confidence.</p>
          <a class="card-link" href="/math/class-8/">Explore Class 8 →</a>
        </article>

        <article class="class-card">
          <span class="class-number">CLASS 09</span>
          <h3>Intermediate Mathematics</h3>
          <p>A structured place for step-by-step lessons, chapter notes, and guided practice material.</p>
          <a class="card-link" href="/math/class-9/">Explore Class 9 →</a>
        </article>

        <article class="class-card">
          <span class="class-number">CLASS 10</span>
          <h3>Board & Mastery Math</h3>
          <p>Learn, revise, and strengthen key mathematical ideas and problem-solving skills.</p>
          <a class="card-link" href="/math/class-10/">Explore Class 10 →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       3. VIDEOS SECTION (Most recent 3 videos/playlists + link to /videos/)
       ====================================================================== -->
  {recentVideos.length > 0 && (
    <section class="section section-soft">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Recent Videos & Playlists</h2>
            <p>Latest chapter lessons added to the PurpleTheta video library.</p>
          </div>
          <a class="text-link" href="/videos/">All videos ↗</a>
        </div>

        <div class="video-grid">
          {recentVideos.map((item) => {
            const thumb = getVideoThumbnail(item.data.youtubeUrl);
            return (
              <article class="video-card">
                <a class="video-thumb" href="/videos/" aria-label={`Watch ${item.data.title} on Videos page`}>
                  {thumb ? (
                    <img
                      src={thumb}
                      alt={`${item.data.classLevel} ${item.data.chapter} thumbnail`}
                      loading="lazy"
                    />
                  ) : (
                    <span>▶</span>
                  )}
                </a>
                <div class="video-info">
                  <div class="article-meta">
                    {item.data.classLevel} · {item.data.chapter}
                  </div>
                  <h3>{item.data.title}</h3>
                  <p>{item.data.description}</p>
                  <a class="card-link" href="/videos/">Watch in video library →</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================================
       4. BLOGS SECTION (Latest 3 blog articles)
       ====================================================================== -->
  {blogs.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>From the blog</h2>
            <p>Fresh ideas and clear explanations to explore.</p>
          </div>
          <a class="text-link" href="/blog/">All articles ↗</a>
        </div>

        <div class="blog-grid">
          {blogs.map((blog) => (
            <article class="article-card">
              <div class="article-body">
                <div class="article-meta">
                  {blog.data.category} · {blog.data.pubDate.toLocaleDateString('en', { dateStyle: 'medium' })}
                </div>
                <h3>{blog.data.title}</h3>
                <p>{blog.data.description}</p>
                <a class="card-link" href={`/blog/${blog.id}/`}>Read article →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================================
       5. BOOKS SECTION (Featured books)
       ====================================================================== -->
  {books.length > 0 && (
    <section class="section section-soft">
      <div class="wrap">
        <div class="section-head">
          <div>
            <h2>Featured Books</h2>
            <p>Curated reads and visual explorations for curious learners.</p>
          </div>
          <a class="text-link" href="/books/">All books ↗</a>
        </div>

        <div class="book-grid">
          {books.map((book) => (
            <article class="book-card">
              <div class="book-cover">
                {book.data.cover ? (
                  <img src={book.data.cover} alt={book.data.title} loading="lazy" />
                ) : (
                  <span>{book.data.title}</span>
                )}
              </div>
              <div class="book-info">
                <h3>{book.data.title}</h3>
                <p>{book.data.description}</p>
                <a class="card-link" href={`/books/${book.id}/`}>View book →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================================
       6. ABOUT & BOTTOM CALL-TO-ACTION BANNER
       ====================================================================== -->
  <section class="cta-band">
    <div class="wrap cta-band-inner">
      <div>
        <h2>About PurpleTheta</h2>
        <p>
          Built to make mathematics approachable, visual, and meaningful.{' '}
          <a class="text-link" href="/about/">Learn more about us →</a>
        </p>
      </div>
      <a class="button" href="/math/">Start exploring <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
