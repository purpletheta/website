---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="Blogs & Articles" description="Explore PurpleTheta articles on mathematics, science, technology, interesting facts and other ideas worth reading."><section class="page-hero"><div class="wrap page-heading"><p class="eyebrow">Read · Think · Discover</p><h1>Ideas worth<br />exploring.</h1><p>Articles on mathematics, science, interesting facts and topics that spark curiosity.</p></div></section><section class="section"><div class="wrap"><div class="blog-grid">{posts.map(post=><article class="article-card"><div class="article-body"><div class="article-meta">{post.data.category} · {post.data.pubDate.toLocaleDateString('en',{dateStyle:'medium'})}</div><h3>{post.data.title}</h3><p>{post.data.description}</p><a class="card-link" href={`/blog/${post.slug}/`}>Read article →</a></div></article>)}</div>{posts.length===0&&<p>No articles have been published yet.</p>}</div></section></BaseLayout>
