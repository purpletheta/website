---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Generate a static page for every book inside src/content/books/
export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);

// Check if buy/read links or gallery images exist
const hasLinks = book.data.amazonUrl || book.data.googlePlayUrl || book.data.websiteUrl;
const hasGallery = book.data.gallery && book.data.gallery.length > 0;

// Build compact "At a Glance" items only for fields that are filled in
const bookSpecs = [
  book.data.readingAge ? { label: 'Reading age', value: String(book.data.readingAge) } : null,
  book.data.pages ? { label: 'Print length', value: `${book.data.pages}`.toLowerCase().includes('page') ? String(book.data.pages) : `${book.data.pages} pages` } : null,
  book.data.format ? { label: 'Format', value: String(book.data.format) } : null,
  book.data.language ? { label: 'Language', value: String(book.data.language) } : null,
  book.data.dimensions ? { label: 'Dimensions', value: String(book.data.dimensions) } : null,
  book.data.publishDate ? { label: 'Publication date', value: String(book.data.publishDate) } : null,
].filter((item): item is { label: string; value: string } => item !== null);
---

<BaseLayout title={book.data.title} description={book.data.description}>
  <!-- ======================================================================
       1. TOP BOOK SHOWCASE (Cover + Title + Buy Links + Compact Specs Strip)
       ====================================================================== -->
  <section class="page-hero">
    <div class="wrap">
      <!-- Top breadcrumb link back to Books page -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/books/">← Back to all books</a>
        <span> · {book.data.category}</span>
      </nav>

      <div class="book-detail-hero">
        <!-- Left column: Main book cover -->
        <div class="book-detail-cover">
          {book.data.cover ? (
            <img src={book.data.cover} alt={`Cover of ${book.data.title}`} />
          ) : (
            <div class="book-cover-placeholder">
              <small>PURPLETHETA</small>
              <span>{book.data.title}</span>
            </div>
          )}
        </div>

        <!-- Right column: Badges, Title, Intro, Buy Buttons & Compact Book Specs -->
        <div class="book-detail-meta">
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px;">
            <span class="pill">{book.data.category}</span>
            <span class="pill" style="background: var(--soft); color: var(--muted); border: 1px solid var(--line);">
              {book.data.label}
            </span>
          </div>

          <h1 class="book-detail-title">{book.data.title}</h1>
          <p class="book-detail-summary">{book.data.description}</p>

          <!-- Purchase & Reading Links -->
          {hasLinks && (
            <div class="buy-box">
              <p class="buy-box-label">Get this book:</p>
              <div class="buy-buttons">
                {book.data.amazonUrl && (
                  <a href={book.data.amazonUrl} target="_blank" rel="noopener noreferrer" class="button">
                    Buy on Amazon <span>↗</span>
                  </a>
                )}
                {book.data.googlePlayUrl && (
                  <a href={book.data.googlePlayUrl} target="_blank" rel="noopener noreferrer" class="button button-outline">
                    Google Play Books <span>↗</span>
                  </a>
                )}
                {book.data.websiteUrl && (
                  <a href={book.data.websiteUrl} class="button button-outline">
                    {book.data.websiteLabel} <span>→</span>
                  </a>
                )}
              </div>
            </div>
          )}

          <!-- Compact Amazon-style "At a Glance" Book Specs just below intro -->
          {bookSpecs.length > 0 && (
            <div class="book-specs-strip" aria-label="Book specifications">
              {bookSpecs.map((spec) => (
                <div class="spec-item">
                  <span class="spec-label">{spec.label}</span>
                  <span class="spec-value">{spec.value}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       2. LOWER SECTION: TIGHT IMAGE VIEWER (LEFT) + COLLAPSIBLE ABOUT (RIGHT)
       ====================================================================== -->
  <section class="section">
    <div class="wrap">
      <div class:list={['book-split-layout', !hasGallery && 'no-gallery']}>

        <!-- LEFT COLUMN: Clean single preview image (no side blank space) + bottom thumbnails -->
        {hasGallery && (
          <div class="amazon-viewer" data-gallery={JSON.stringify(book.data.gallery)}>
            <div class="amazon-main-frame">
              <button
                type="button"
                id="viewer-open-zoom"
                class="amazon-main-btn"
                aria-label="Click to view larger image"
              >
                <img
                  id="viewer-main-img"
                  src={book.data.gallery[0]}
                  alt={`${book.data.title} preview 1`}
                />
              </button>
            </div>

            <!-- Small thumbnail boxes below the preview image -->
            <div class="amazon-thumbs" role="list" aria-label="Page thumbnails">
              {book.data.gallery.map((thumbSrc, idx) => (
                <button
                  type="button"
                  class:list={['amazon-thumb-btn', idx === 0 && 'active']}
                  data-index={idx}
                  aria-label={`Select preview image ${idx + 1}`}
                >
                  <img
                    src={thumbSrc}
                    alt={`${book.data.title} thumbnail ${idx + 1}`}
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- RIGHT COLUMN: About This Book with "Read more..." toggle when long -->
        <div class="book-about-column prose">
          <h2>About This Book</h2>
          <div id="about-body" class="about-text-box">
            <Content />
          </div>
          <button
            type="button"
            id="about-toggle-btn"
            class="read-more-link"
            hidden
          >
            Read more...
          </button>
        </div>

      </div>
    </div>
  </section>

  <!-- ======================================================================
       3. FULLSCREEN LIGHTBOX (Opens when clicking the large preview image)
       ====================================================================== -->
  <dialog id="page-lightbox" class="lightbox-modal">
    <div class="lightbox-topbar">
      <span id="lightbox-counter" class="lightbox-counter">Preview 1</span>
      <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close preview">
        ✕ Close
      </button>
    </div>

    <div class="lightbox-stage">
      {hasGallery && book.data.gallery.length > 1 && (
        <button type="button" id="lightbox-prev" class="lightbox-arrow prev" aria-label="Previous image">
          ‹
        </button>
      )}

      <img id="lightbox-img" src="" alt="Enlarged book preview" />

      {hasGallery && book.data.gallery.length > 1 && (
        <button type="button" id="lightbox-next" class="lightbox-arrow next" aria-label="Next image">
          ›
        </button>
      )}
    </div>
  </dialog>

  <!-- ======================================================================
       4. STYLES
       ====================================================================== -->
  <style>
    /* Top Book Cover + Metadata Layout */
    .book-detail-hero {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 48px;
      align-items: start;
      margin-top: 12px;
    }

    .book-detail-cover img {
      width: 100%;
      border-radius: 10px;
      border: 1px solid var(--purple-border);
      box-shadow: 0 16px 36px rgba(30, 27, 38, 0.14);
      display: block;
    }

    .book-cover-placeholder {
      aspect-ratio: 2 / 3;
      background: var(--purple-soft);
      border: 1px solid var(--purple-border);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      color: var(--purple);
      font-family: 'Manrope', sans-serif;
      font-weight: 800;
      font-size: 20px;
    }

    .book-cover-placeholder small {
      font-size: 11px;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
    }

    .book-detail-title {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(32px, 4vw, 46px);
      font-weight: 800;
      letter-spacing: -1.5px;
      line-height: 1.12;
      margin: 0 0 14px;
    }

    .book-detail-summary {
      font-size: 17px;
      color: var(--muted);
      line-height: 1.65;
      margin: 0 0 22px;
      max-width: 680px;
    }

    /* Buy / Where to Read Box */
    .buy-box {
      background: #fff;
      border: 1px solid var(--purple-border);
      border-radius: 10px;
      padding: 18px 22px;
      box-shadow: var(--shadow-sm);
    }

    .buy-box-label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      margin: 0 0 10px;
    }

    .buy-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .button-outline {
      background: var(--purple-soft);
      color: var(--purple);
      border: 1px solid var(--purple-border);
      box-shadow: none;
    }

    .button-outline:hover {
      background: var(--purple);
      color: #fff;
      border-color: var(--purple);
    }

    /* Compact Amazon-style "At a Glance" Book Specs Row */
    .book-specs-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 28px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }

    .spec-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 96px;
    }

    .spec-label {
      font-size: 11.5px;
      font-weight: 700;
      color: var(--muted);
      line-height: 1.3;
    }

    .spec-value {
      font-size: 13px;
      font-weight: 600;
      color: var(--ink);
      line-height: 1.35;
    }

    /* Lower Two-Column Split: Image Column Sized to Fit Content + Wide About Column */
    .book-split-layout {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 48px;
      align-items: start;
    }

    .book-split-layout.no-gallery {
      grid-template-columns: 1fr;
      max-width: 780px;
    }

    .amazon-viewer {
      width: fit-content;
      max-width: 100%;
    }

    /* Frame hugs the image cleanly so portrait pages have zero extra side blank space */
    .amazon-main-frame {
      display: inline-block;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--soft);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .amazon-main-btn {
      display: block;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: zoom-in;
    }

    .amazon-main-btn img {
      display: block;
      width: auto;
      max-width: 100%;
      max-height: 430px;
      height: auto;
    }

    /* Row of small thumbnail boxes underneath the preview image */
    .amazon-thumbs {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 12px;
    }

    .amazon-thumb-btn {
      width: 58px;
      height: 66px;
      padding: 2px;
      border: 1.5px solid var(--line);
      border-radius: 6px;
      background: #fff;
      cursor: pointer;
      overflow: hidden;
      opacity: 0.78;
      transition: border-color 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
    }

    .amazon-thumb-btn:hover {
      opacity: 1;
      border-color: #b79fe3;
    }

    .amazon-thumb-btn.active {
      opacity: 1;
      border-color: var(--purple);
      box-shadow: 0 0 0 2px var(--purple-soft);
      transform: translateY(-1px);
    }

    .amazon-thumb-btn img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 4px;
      display: block;
    }

    /* About This Book column & collapsible "Read more..." behavior */
    .book-about-column {
      min-width: 0;
      max-width: 720px;
    }

    .book-about-column h2 {
      margin-top: 0;
    }

    .about-text-box.collapsed {
      max-height: 360px;
      overflow: hidden;
      position: relative;
      mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    }

    .read-more-link {
      display: inline-block;
      margin-top: 10px;
      padding: 0;
      border: 0;
      background: none;
      color: var(--purple);
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
    }

    .read-more-link:hover {
      color: var(--purple-dark);
      text-decoration: underline;
    }

    /* Lightbox Popup Styles */
    .lightbox-modal {
      border: 0;
      border-radius: 12px;
      padding: 16px;
      background: #1e1b26;
      max-width: 92vw;
      max-height: 92vh;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55);
    }

    .lightbox-modal::backdrop {
      background: rgba(15, 13, 22, 0.84);
      backdrop-filter: blur(4px);
    }

    .lightbox-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .lightbox-counter {
      color: #e5dff2;
      font-size: 13px;
      font-weight: 600;
    }

    .lightbox-close {
      background: #fff;
      color: var(--ink);
      border: 0;
      border-radius: 6px;
      padding: 6px 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .lightbox-stage {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-modal img {
      max-width: 84vw;
      max-height: 78vh;
      display: block;
      border-radius: 6px;
    }

    .lightbox-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 0;
      background: rgba(255, 255, 255, 0.92);
      color: var(--ink);
      font-size: 28px;
      line-height: 1;
      display: grid;
      place-items: center;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }

    .lightbox-arrow:hover {
      background: var(--purple);
      color: #fff;
    }

    .lightbox-arrow.prev {
      left: 12px;
    }

    .lightbox-arrow.next {
      right: 12px;
    }

    /* Responsive Adjustments for Tablet & Mobile */
    @media (max-width: 880px) {
      .book-split-layout {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .amazon-viewer {
        width: 100%;
      }
      .amazon-main-frame {
        display: block;
      }
      .amazon-main-btn {
        width: 100%;
      }
      .amazon-main-btn img {
        margin-inline: auto;
      }
    }

    @media (max-width: 780px) {
      .book-detail-hero {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .book-detail-cover {
        max-width: 240px;
      }
    }
  </style>

  <!-- ======================================================================
       5. THUMBNAIL SWITCHING, LIGHTBOX & "READ MORE..." SCRIPT
       ====================================================================== -->
  <script>
    const viewer = document.querySelector('.amazon-viewer');
    const images: string[] = viewer
      ? JSON.parse(viewer.getAttribute('data-gallery') || '[]')
      : [];

    let currentIndex = 0;

    // Main viewer & thumbnail elements
    const mainImg = document.getElementById('viewer-main-img') as HTMLImageElement | null;
    const thumbButtons = document.querySelectorAll('.amazon-thumb-btn');
    const openZoomBtn = document.getElementById('viewer-open-zoom');

    // Lightbox elements
    const modal = document.getElementById('page-lightbox') as HTMLDialogElement | null;
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const modalCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');

    // Switch active image in both the main viewer and lightbox
    function selectImage(index: number) {
      if (images.length === 0) return;
      currentIndex = (index + images.length) % images.length;

      if (mainImg) {
        mainImg.src = images[currentIndex];
        mainImg.alt = `Book preview ${currentIndex + 1}`;
      }

      thumbButtons.forEach((btn, idx) => {
        btn.classList.toggle('active', idx === currentIndex);
      });

      if (modalImg) {
        modalImg.src = images[currentIndex];
      }
      if (modalCounter) {
        modalCounter.textContent = `Preview ${currentIndex + 1} of ${images.length}`;
      }
    }

    thumbButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index') || 0);
        selectImage(idx);
      });
    });

    openZoomBtn?.addEventListener('click', () => {
      if (modal && images.length > 0) {
        selectImage(currentIndex);
        modal.showModal();
      }
    });

    lbPrev?.addEventListener('click', () => selectImage(currentIndex - 1));
    lbNext?.addEventListener('click', () => selectImage(currentIndex + 1));
    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    document.addEventListener('keydown', (e) => {
      if (images.length <= 1 || !modal?.open) return;
      if (e.key === 'ArrowLeft') selectImage(currentIndex - 1);
      if (e.key === 'ArrowRight') selectImage(currentIndex + 1);
    });

    // Collapsible "Read more..." behavior for long "About This Book" content
    const aboutBox = document.getElementById('about-body');
    const aboutToggle = document.getElementById('about-toggle-btn');

    if (aboutBox && aboutToggle) {
      // Only collapse if content is taller than the preview threshold
      if (aboutBox.scrollHeight > 410) {
        aboutBox.classList.add('collapsed');
        aboutToggle.hidden = false;

        aboutToggle.addEventListener('click', () => {
          const isCollapsed = aboutBox.classList.toggle('collapsed');
          aboutToggle.textContent = isCollapsed ? 'Read more...' : 'Show less';
        });
      }
    }
  </script>
</BaseLayout>
