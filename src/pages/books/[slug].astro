---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Generate a static page for every book in src/content/books/
export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);

// Check if buy/read links or gallery images exist
const hasLinks = book.data.amazonUrl || book.data.googlePlayUrl || book.data.websiteUrl;
const hasGallery = book.data.gallery && book.data.gallery.length > 0;
---

<BaseLayout title={book.data.title} description={book.data.description}>
  <!-- ======================================================================
       1. TOP BOOK SHOWCASE (Cover + Title + Buy/Read Links)
       ====================================================================== -->
  <section class="page-hero">
    <div class="wrap">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/books/">← Back to all books</a>
        <span> · {book.data.category}</span>
      </nav>

      <div class="book-detail-hero">
        <!-- Left Column: Main Book Cover -->
        <div class="book-detail-cover">
          {book.data.cover ? (
            <img src={book.data.cover} alt={`Cover of ${book.data.title}`} />
          ) : (
            <div class="book-cover-placeholder">
              <small>PURPLETHETA</small>
              <span>{book.data.title}</span>
            </div>
          )}
        </div>

        <!-- Right Column: Metadata, Summary & Buy Buttons -->
        <div class="book-detail-meta">
          <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px;">
            <span class="pill">{book.data.category}</span>
            <span class="pill" style="background: var(--soft); color: var(--muted); border: 1px solid var(--line);">
              {book.data.label}
            </span>
          </div>

          <h1 class="book-detail-title">{book.data.title}</h1>
          <p class="book-detail-summary">{book.data.description}</p>

          <!-- Purchase & Reading Links -->
          {hasLinks && (
            <div class="buy-box">
              <p class="buy-box-label">Get this book:</p>
              <div class="buy-buttons">
                {book.data.amazonUrl && (
                  <a href={book.data.amazonUrl} target="_blank" rel="noopener noreferrer" class="button">
                    Buy on Amazon <span>↗</span>
                  </a>
                )}
                {book.data.googlePlayUrl && (
                  <a href={book.data.googlePlayUrl} target="_blank" rel="noopener noreferrer" class="button button-outline">
                    Google Play Books <span>↗</span>
                  </a>
                )}
                {book.data.websiteUrl && (
                  <a href={book.data.websiteUrl} class="button button-outline">
                    {book.data.websiteLabel} <span>→</span>
                  </a>
                )}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       2. TWO-COLUMN SPLIT: LOOK INSIDE CAROUSEL (LEFT) + ABOUT THIS BOOK (RIGHT)
       ====================================================================== -->
  <section class="section">
    <div class="wrap">
      <div class:list={['book-split-layout', !hasGallery && 'no-gallery']}>
        
        <!-- LEFT COLUMN: Single-Frame Image Slider with Arrows & Dots -->
        {hasGallery && (
          <div class="book-preview-column">
            <h2 class="split-heading">Look Inside the Book</h2>
            <p class="split-sub">Use arrows or dots to flip pages. Click image to zoom.</p>

            <div class="carousel-card" data-gallery={JSON.stringify(book.data.gallery)}>
              <!-- Main Image Viewer -->
              <div class="carousel-stage">
                <button
                  type="button"
                  id="carousel-open-zoom"
                  class="carousel-image-btn"
                  aria-label="Click to view full-screen page"
                >
                  <img
                    id="carousel-active-img"
                    src={book.data.gallery[0]}
                    alt={`${book.data.title} - Page 1`}
                  />
                  <span class="zoom-hint">🔍 Click to enlarge</span>
                </button>

                <!-- Left & Right Navigation Arrows (shown when more than 1 image) -->
                {book.data.gallery.length > 1 && (
                  <>
                    <button
                      type="button"
                      id="carousel-prev"
                      class="carousel-arrow prev"
                      aria-label="Previous sample page"
                    >
                      ‹
                    </button>
                    <button
                      type="button"
                      id="carousel-next"
                      class="carousel-arrow next"
                      aria-label="Next sample page"
                    >
                      ›
                    </button>
                  </>
                )}
              </div>

              <!-- Bottom Controls: Page Counter + Navigation Dots -->
              <div class="carousel-footer">
                <span id="carousel-counter" class="carousel-counter">
                  Page 1 of {book.data.gallery.length}
                </span>

                {book.data.gallery.length > 1 && (
                  <div class="carousel-dots" role="tablist" aria-label="Sample pages">
                    {book.data.gallery.map((_, idx) => (
                      <button
                        type="button"
                        class:list={['carousel-dot', idx === 0 && 'active']}
                        data-index={idx}
                        aria-label={`Go to page ${idx + 1}`}
                      />
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        )}

        <!-- RIGHT COLUMN: About This Book (Your 3–4 paragraphs from Markdown) -->
        <div class="book-about-column prose">
          <h2 class="split-heading" style="margin-top: 0;">About This Book</h2>
          <Content />
        </div>

      </div>
    </div>
  </section>

  <!-- ======================================================================
       3. FULLSCREEN LIGHTBOX POPUP (With Next/Previous Page Navigation)
       ====================================================================== -->
  <dialog id="page-lightbox" class="lightbox-modal">
    <div class="lightbox-topbar">
      <span id="lightbox-counter" class="lightbox-counter">Page 1</span>
      <button type="button" id="lightbox-close" class="lightbox-close" aria-label="Close preview">
        ✕ Close
      </button>
    </div>

    <div class="lightbox-stage">
      {hasGallery && book.data.gallery.length > 1 && (
        <button type="button" id="lightbox-prev" class="lightbox-arrow prev" aria-label="Previous page">
          ‹
        </button>
      )}

      <img id="lightbox-img" src="" alt="Book page preview" />

      {hasGallery && book.data.gallery.length > 1 && (
        <button type="button" id="lightbox-next" class="lightbox-arrow next" aria-label="Next page">
          ›
        </button>
      )}
    </div>
  </dialog>

  <!-- ======================================================================
       4. STYLES FOR BOOK DETAIL, CAROUSEL & LIGHTBOX
       ====================================================================== -->
  <style>
    /* Top Book Cover + Metadata Layout */
    .book-detail-hero {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 48px;
      align-items: start;
      margin-top: 12px;
    }

    .book-detail-cover img {
      width: 100%;
      border-radius: 10px;
      border: 1px solid var(--purple-border);
      box-shadow: 0 16px 36px rgba(30, 27, 38, 0.14);
      display: block;
    }

    .book-cover-placeholder {
      aspect-ratio: 2 / 3;
      background: var(--purple-soft);
      border: 1px solid var(--purple-border);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      text-align: center;
      color: var(--purple);
      font-family: 'Manrope', sans-serif;
      font-weight: 800;
      font-size: 20px;
    }

    .book-cover-placeholder small {
      font-size: 11px;
      letter-spacing: 1.5px;
      margin-bottom: 10px;
    }

    .book-detail-title {
      font-family: 'Manrope', sans-serif;
      font-size: clamp(32px, 4vw, 46px);
      font-weight: 800;
      letter-spacing: -1.5px;
      line-height: 1.12;
      margin: 0 0 16px;
    }

    .book-detail-summary {
      font-size: 17.5px;
      color: var(--muted);
      line-height: 1.65;
      margin: 0 0 28px;
      max-width: 620px;
    }

    /* Buy / Where to Read Box */
    .buy-box {
      background: #fff;
      border: 1px solid var(--purple-border);
      border-radius: 10px;
      padding: 20px 24px;
      box-shadow: var(--shadow-sm);
    }

    .buy-box-label {
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--muted);
      margin: 0 0 12px;
    }

    .buy-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .button-outline {
      background: var(--purple-soft);
      color: var(--purple);
      border: 1px solid var(--purple-border);
      box-shadow: none;
    }

    .button-outline:hover {
      background: var(--purple);
      color: #fff;
      border-color: var(--purple);
    }

    /* Two-Column Split: Carousel (Left) + About This Book (Right) */
    .book-split-layout {
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      gap: 48px;
      align-items: start;
    }

    .book-split-layout.no-gallery {
      grid-template-columns: 1fr;
      max-width: 780px;
    }

    .split-heading {
      font-family: 'Manrope', sans-serif;
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.8px;
      margin: 0 0 6px;
    }

    .split-sub {
      font-size: 14px;
      color: var(--muted);
      margin: 0 0 18px;
    }

    /* Single-Frame Image Carousel Card */
    .carousel-card {
      background: var(--soft);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px;
      box-shadow: var(--shadow-sm);
    }

    .carousel-stage {
      position: relative;
      background: #fff;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }

    .carousel-image-btn {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: #fff;
      cursor: zoom-in;
      position: relative;
    }

    .carousel-image-btn img {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: contain;
      background: #fff;
      display: block;
      transition: transform 0.25s ease;
    }

    .carousel-image-btn:hover img {
      transform: scale(1.015);
    }

    .zoom-hint {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(30, 27, 38, 0.78);
      color: #fff;
      font-size: 11.5px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 99px;
      pointer-events: none;
    }

    /* Left & Right Slider Arrows */
    .carousel-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid var(--purple-border);
      background: rgba(255, 255, 255, 0.94);
      color: var(--purple);
      font-size: 24px;
      line-height: 1;
      display: grid;
      place-items: center;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(30, 27, 38, 0.14);
      transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
      z-index: 2;
    }

    .carousel-arrow:hover {
      background: var(--purple);
      color: #fff;
      transform: translateY(-50%) scale(1.06);
    }

    .carousel-arrow.prev {
      left: 12px;
    }

    .carousel-arrow.next {
      right: 12px;
    }

    /* Carousel Footer: Page Counter + Dots */
    .carousel-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 14px;
      padding: 0 4px;
    }

    .carousel-counter {
      font-size: 13px;
      font-weight: 600;
      color: var(--muted);
    }

    .carousel-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .carousel-dot {
      width: 9px;
      height: 9px;
      border-radius: 99px;
      border: 0;
      padding: 0;
      background: #d3c8e8;
      cursor: pointer;
      transition: width 0.2s ease, background-color 0.2s ease;
    }

    .carousel-dot.active {
      width: 24px;
      background: var(--purple);
    }

    /* Lightbox Popup with Arrows */
    .lightbox-modal {
      border: 0;
      border-radius: 12px;
      padding: 16px;
      background: #1e1b26;
      max-width: 92vw;
      max-height: 92vh;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.55);
    }

    .lightbox-modal::backdrop {
      background: rgba(15, 13, 22, 0.84);
      backdrop-filter: blur(4px);
    }

    .lightbox-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .lightbox-counter {
      color: #e5dff2;
      font-size: 13px;
      font-weight: 600;
    }

    .lightbox-close {
      background: #fff;
      color: var(--ink);
      border: 0;
      border-radius: 6px;
      padding: 6px 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .lightbox-stage {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .lightbox-modal img {
      max-width: 84vw;
      max-height: 78vh;
      display: block;
      border-radius: 6px;
    }

    .lightbox-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 0;
      background: rgba(255, 255, 255, 0.92);
      color: var(--ink);
      font-size: 28px;
      line-height: 1;
      display: grid;
      place-items: center;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }

    .lightbox-arrow:hover {
      background: var(--purple);
      color: #fff;
    }

    .lightbox-arrow.prev {
      left: 12px;
    }

    .lightbox-arrow.next {
      right: 12px;
    }

    /* Responsive Adjustments for Tablet & Mobile */
    @media (max-width: 880px) {
      .book-split-layout {
        grid-template-columns: 1fr;
        gap: 36px;
      }
    }

    @media (max-width: 780px) {
      .book-detail-hero {
        grid-template-columns: 1fr;
        gap: 28px;
      }
      .book-detail-cover {
        max-width: 240px;
      }
    }
  </style>

  <!-- ======================================================================
       5. INTERACTIVE SLIDER & LIGHTBOX SCRIPT
       ====================================================================== -->
  <script>
    const carouselCard = document.querySelector('.carousel-card');
    const images: string[] = carouselCard
      ? JSON.parse(carouselCard.getAttribute('data-gallery') || '[]')
      : [];

    let currentIndex = 0;

    // Carousel elements
    const activeImg = document.getElementById('carousel-active-img') as HTMLImageElement | null;
    const counterEl = document.getElementById('carousel-counter');
    const dots = document.querySelectorAll('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const openZoomBtn = document.getElementById('carousel-open-zoom');

    // Lightbox elements
    const modal = document.getElementById('page-lightbox') as HTMLDialogElement | null;
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const modalCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const lbPrev = document.getElementById('lightbox-prev');
    const lbNext = document.getElementById('lightbox-next');

    // Updates both the inline carousel and the fullscreen lightbox to the chosen page
    function showSlide(newIndex: number) {
      if (images.length === 0) return;
      currentIndex = (newIndex + images.length) % images.length;

      if (activeImg) {
        activeImg.src = images[currentIndex];
        activeImg.alt = `Sample page ${currentIndex + 1}`;
      }
      if (counterEl) {
        counterEl.textContent = `Page ${currentIndex + 1} of ${images.length}`;
      }
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === currentIndex);
      });

      if (modalImg) {
        modalImg.src = images[currentIndex];
      }
      if (modalCounter) {
        modalCounter.textContent = `Page ${currentIndex + 1} of ${images.length}`;
      }
    }

    // Inline carousel controls
    prevBtn?.addEventListener('click', () => showSlide(currentIndex - 1));
    nextBtn?.addEventListener('click', () => showSlide(currentIndex + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = Number(dot.getAttribute('data-index') || 0);
        showSlide(idx);
      });
    });

    // Open fullscreen lightbox on image click
    openZoomBtn?.addEventListener('click', () => {
      if (modal && images.length > 0) {
        showSlide(currentIndex);
        modal.showModal();
      }
    });

    // Lightbox navigation & close controls
    lbPrev?.addEventListener('click', () => showSlide(currentIndex - 1));
    lbNext?.addEventListener('click', () => showSlide(currentIndex + 1));
    closeBtn?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });

    // Keyboard Left/Right arrow support when viewing pages
    document.addEventListener('keydown', (e) => {
      if (images.length <= 1) return;
      if (e.key === 'ArrowLeft') showSlide(currentIndex - 1);
      if (e.key === 'ArrowRight') showSlide(currentIndex + 1);
    });
  </script>
</BaseLayout>
