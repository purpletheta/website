---
import BaseLayout from '../../layouts/BaseLayout.astro';
const books=[{title:'Squares and Square Roots',description:'A concept-focused Class 8 learning resource exploring square numbers, patterns, properties and square roots.',label:'Class 8 Mathematics'},{title:'20 Things About Zero',description:'A curiosity-led book introducing children to the fascinating ideas and stories connected with zero.',label:'Children · Mathematics'}];
---
<BaseLayout title="Books" description="Discover PurpleTheta e-books and reading resources. Find book descriptions, previews and links to Google Play Books or Amazon."><section class="page-hero"><div class="wrap page-heading"><p class="eyebrow">Read · Learn</p><h1>Books &amp; Resources</h1><p>Books that make ideas approachable, encourage curiosity and help readers explore concepts in more depth.</p></div></section><section class="section"><div class="wrap"><div class="book-grid">{books.map(book=><article class="book-card"><div class="book-cover"><div><small style="display:block;font-size:12px;letter-spacing:1.4px;font-weight:500;margin-bottom:12px">PURPLETHETA</small>{book.title}</div></div><div class="book-info"><div class="article-meta">{book.label}</div><h3>{book.title}</h3><p>{book.description}</p><span class="card-link">Book links to be added</span></div></article>)}</div><div class="empty-note" style="margin-top:24px">Book purchase links will open directly on Google Play Books, Amazon or the publisher platform. There will be no cart or checkout on this website.</div></div></section></BaseLayout>
