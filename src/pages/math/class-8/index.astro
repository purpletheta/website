---
import BaseLayout from '../../../layouts/BaseLayout.astro';
const chapters=[{title:'Squares and Square Roots',slug:'squares-and-square-roots',description:'Explore square numbers, their patterns, properties and square roots.'},{title:'Cubes and Cube Roots',slug:'cubes-and-cube-roots',description:'Understand cubes, cube patterns, perfect cubes and cube roots.'},{title:'Exponents and Powers',slug:'exponents-and-powers',description:'Learn exponent laws and how powers express very large and very small numbers.'}];
---
<BaseLayout title="Class 8 Mathematics" description="Class 8 mathematics lessons, chapter explanations, examples, videos and practice material from PurpleTheta."><section class="page-hero"><div class="wrap page-heading"><div class="breadcrumbs"><a href="/math/">Mathematics</a> / Class 8</div><p class="eyebrow">Mathematics · Class 8</p><h1>Learn. Understand.<br />Practice.</h1><p>Study each topic at your own pace with clear explanations and step-by-step examples. More chapters will be added as they are prepared.</p></div></section><section class="section"><div class="wrap"><div class="section-head"><div><h2>Chapters</h2><p>Choose a chapter to begin.</p></div></div><div class="class-grid">{chapters.map((chapter,i)=><article class="class-card"><span class="class-number">CHAPTER {String(i+1).padStart(2,'0')}</span><h3>{chapter.title}</h3><p>{chapter.description}</p><a class="card-link" href={`/math/class-8/chapters/${chapter.slug}/`}>Explore chapter →</a></article>)}</div><div class="empty-note" style="margin-top:24px">Chapter pages can be expanded with subtopics, notes, videos, solved examples and practice questions as content is published.</div></div></section></BaseLayout>
